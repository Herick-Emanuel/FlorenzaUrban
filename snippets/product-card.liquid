{%- if product and product != empty -%}
  {%- assign card_alt = product.featured_media.alt | default: product.title -%}
  <a class="product-card" href="{{ product.url }}" title="{{ product.title | escape }}">
    <div class="product-media">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            widths: '300, 450, 600, 800',
            sizes: '(min-width: 990px) 25vw, 50vw',
            alt: card_alt
        }}
        {%- if product.media[1] != blank -%}
          {{
            product.media[1]
            | image_url: width: 800
            | image_tag:
              class: 'img-alt',
              loading: 'lazy',
              widths: '300, 450, 600, 800',
              sizes: '(min-width: 990px) 25vw, 50vw',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}

      {%- if product.compare_at_price > product.price -%}
        <span class="product-badge sale">{{ 'products.product.on_sale' | t }}</span>
      {%- elsif product.tags contains 'new' or product.tags contains 'novo' -%}
        <span class="product-badge new">{{ 'products.product.new' | t }}</span>
      {%- endif -%}
    </div>

    {%- if product.vendor != blank -%}
      <p class="product-brand">{{ product.vendor }}</p>
    {%- endif -%}
    <h3 class="product-name">{{ product.title }}</h3>
    <div class="product-price">
      <span class="price-current">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="price-old">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
  </a>
{%- endif -%}
