<header class="page-hero">
  <p class="eyebrow">{{ 'cart.general.eyebrow' | t }}</p>
  <h1>{{ 'cart.general.title' | t }}</h1>
</header>

<section class="section">
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <div class="products-grid" style="grid-template-columns:1fr;gap:24px;max-width:800px">
        {%- for item in cart.items -%}
          <div style="display:grid;grid-template-columns:100px 1fr auto;gap:20px;align-items:center;border-bottom:1px solid var(--line);padding-bottom:20px">
            {%- if item.image -%}
              <a href="{{ item.url }}">
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="125" loading="lazy" style="object-fit:cover;width:100px;height:125px">
              </a>
            {%- endif -%}
            <div>
              <a href="{{ item.url }}" class="product-name" style="display:block">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p style="color:var(--ivory-dim);font-size:13px;margin:6px 0">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="product-price">{{ item.final_line_price | money }}</p>
              <label class="visually-hidden" for="updates_{{ item.key }}">{{ 'cart.general.quantity' | t }}</label>
              <input
                id="updates_{{ item.key }}"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                style="width:72px;margin-top:10px;background:transparent;border:1px solid var(--line);color:var(--ivory);padding:8px"
              >
            </div>
            <a href="{{ item.url_to_remove }}" style="color:var(--ivory-dim);font-size:12px;letter-spacing:0.1em;text-transform:uppercase">{{ 'cart.general.remove' | t }}</a>
          </div>
        {%- endfor -%}
      </div>

      <div style="margin-top:40px;max-width:800px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between">
        <p class="section-title" style="font-size:28px">{{ 'cart.general.subtotal' | t }}: {{ cart.total_price | money }}</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <button type="submit" name="update" class="btn btn-ghost">{{ 'cart.general.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn-primary">{{ 'cart.general.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <p style="color:var(--ivory-dim);margin-bottom:28px">{{ 'cart.general.empty' | t }}</p>
    <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Carrinho",
  "settings": []
}
{% endschema %}
