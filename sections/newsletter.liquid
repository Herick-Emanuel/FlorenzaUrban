<section class="newsletter" aria-labelledby="Newsletter-{{ section.id }}">
  <h2 id="Newsletter-{{ section.id }}">{{ section.settings.heading }}</h2>
  {%- if section.settings.text != blank -%}
    <p>{{ section.settings.text }}</p>
  {%- endif -%}

  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
    <input
      id="NewsletterEmail-{{ section.id }}"
      type="email"
      name="contact[email]"
      value="{{ form.email }}"
      placeholder="{{ section.settings.placeholder }}"
      required
      autocomplete="email"
    >
    <button type="submit">{{ section.settings.button_label }}</button>
    {%- if form.posted_successfully? -%}
      <p class="visually-hidden" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
      <script>document.addEventListener('DOMContentLoaded',()=>window.FlorenzaTheme&&FlorenzaTheme.showToast({{ 'newsletter.success' | t | json }}));</script>
    {%- endif -%}
  {% endform %}
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lista da boutique" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Lançamentos, pré-vendas e convites exclusivos no seu e-mail."
    },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "seu@email.com" },
    { "type": "text", "id": "button_label", "label": "Botão", "default": "Inscrever" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
