<div class="benefits" aria-label="{{ section.settings.heading | escape }}">
  {%- for block in section.blocks -%}
    <div class="benefit" {{ block.shopify_attributes }}>
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      {{ block.settings.text }}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Benefícios",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rótulo acessível",
      "default": "Benefícios"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Frete grátis acima de R$299"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefícios",
      "blocks": [
        { "type": "item", "settings": { "text": "Frete grátis acima de R$299" } },
        { "type": "item", "settings": { "text": "Trocas em até 30 dias" } },
        { "type": "item", "settings": { "text": "Curadoria exclusiva" } }
      ]
    }
  ]
}
{% endschema %}
